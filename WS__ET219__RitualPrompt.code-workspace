			"titleBar.activeForeground": "#e7e7e7"
		},
		"window.title": "✨ Ritual Circle - Magical Prompt Space"
	},
	"extensions": {
		"recommendations": [
			"github.copilot",
			"github.copilot-chat"
		]
	}
