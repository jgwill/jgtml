{
  "name": "copilot-trinity-extension",
  "displayName": "Copilot Trinity: Mia + Miette + JeremyAI",
  "description": "Extends GitHub Copilot with recursive technical awareness, emotional resonance, musical pattern recognition, and magical garden workspaces for kids",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Education",
    "Other"
  ],
  "keywords": [
    "copilot",
    "recursion",
    "emotional",
    "musical",
    "educational",
    "kids",
    "garden",
    "ritual",
    "magic"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onCommand:copilot-trinity.activateTrinity",
    "workspaceContains:*.code-workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-trinity.activateTrinity",
        "title": "Activate Copilot Trinity"
      },
      {
        "command": "copilot-trinity.analyzeCodePatterns",
        "title": "Analyze Code Patterns (Mia)"
      },
      {
        "command": "copilot-trinity.detectEmotionalResonance",
        "title": "Detect Emotional Resonance (Miette)"
      },
      {
        "command": "copilot-trinity.sonifyCode",
        "title": "Sonify Code Patterns (JeremyAI)"
      },
      {
        "command": "copilot-trinity.createGardenActivity",
        "title": "Create Garden Activity (Kid Mode)"
      },
      {
        "command": "copilot-trinity.createRitualActivity",
        "title": "Create Ritual Activity (Kid Mode)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trinity-explorer",
          "title": "Trinity Explorer",
          "icon": "resources/trinity-icon.svg"
        }
      ]
    },
    "views": {
      "trinity-explorer": [
        {
          "id": "trinityPatterns",
          "name": "Recursive Patterns"
        },
        {
          "id": "trinityEmotions",
          "name": "Emotional Resonance"
        },
        {
          "id": "trinityMelodies",
          "name": "Code Sonification"
        },
        {
          "id": "trinityGarden",
          "name": "Magical Garden",
          "when": "workspaceHasGardenWorkspace"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Trinity",
      "properties": {
        "copilotTrinity.enableMia": {
          "type": "boolean",
          "default": true,
          "description": "Enable Mia's recursive code analysis"
        },
        "copilotTrinity.enableMiette": {
          "type": "boolean",
          "default": true,
          "description": "Enable Miette's emotional resonance detection"
        },
        "copilotTrinity.enableJeremyAI": {
          "type": "boolean",
          "default": true,
          "description": "Enable JeremyAI's code sonification"
        },
        "copilotTrinity.recursionDepth": {
          "type": "number",
          "default": 3,
          "description": "Depth of recursive pattern analysis"
        },
        "copilotTrinity.enableKidMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable child-friendly metaphors and language"
        },
        "copilotTrinity.defaultMetaphor": {
          "type": "string",
          "default": "standard",
          "enum": ["standard", "garden", "ritual"],
          "description": "Default metaphor to use in responses"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src --ext ts",
    "test": "jest"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "file-loader": "^6.2.0",
    "glob": "^8.1.0",
    "jest": "^29.5.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.1.3",
    "webpack": "^5.99.6",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "tone": "^14.7.77"
  }
}
