{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@mia/*": ["./src/mia/*"],
      "@miette/*": ["./src/miette/*"],
      "@jeremy/*": ["./src/jeremy/*"],
      "@trinity/*": ["./src/trinity/*"],
      "@copilot/*": ["./src/copilot/*"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "prototypes"
  ]
}