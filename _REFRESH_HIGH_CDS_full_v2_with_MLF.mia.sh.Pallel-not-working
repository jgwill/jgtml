#!/bin/bash
# _REFRESH_HIGH_CDS_full_v2_with_MLF.parallel.sh
# Parallel processing done RIGHT

# Initialize environment
unset JGTPY_DATA_FULL JGTPY_DATA
source .env 2>/dev/null || true
export JGTPY_DATA JGTPY_DATA_FULL

# Configuration
MAX_PARALLEL=4  # Optimal for most systems
patterns="mfi mz zonesq"
instruments=("EUR/USD" "USD/CAD" "SPX500" "AUD/USD" "AUD/CAD" "GBP/USD")
timeframes=("W1" "M1" "D1" "H4")

# Create directories in parallel
{
    droxul mkdir /dist/data &>/dev/null
    for d in cds ttf mlf targets; do
        droxul mkdir "/dist/data/full/$d" &>/dev/null
    done
    droxul mkdir "/dist/data/full/targets/mx" &>/dev/null
} &

# Function to run commands with error handling
run_cmd() {
    if ! "$@" &>/dev/null; then
        echo "[ERROR] Failed: $*" >&2
        return 1
    fi
    return 0
}

# Process each timeframe
for t in "${timeframes[@]}"; do
    echo "⌛ Processing $t timeframe..."
    
    # Process instruments in parallel
    for i in "${instruments[@]}"; do
        (
            # CDS processing
            if run_cmd jgtcli -i "$i" -t "$t" --fresh --full; then
                fp=$(jgtcli -i "$i" -t "$t" --fresh --full -vp 2>/dev/null)
                [ -n "$fp" ] && droxul upload "$fp" "/dist/data/full/cds/" &>/dev/null
            fi

            # Pattern processing (skip M1)
            if [ "$t" != "M1" && "$t" != "W1" ]; then
                for p in $patterns; do
                    run_cmd ttfcli -i "$i" -t "$t" -pn "$p" --full -old &>/dev/null
                    run_cmd mlfcli -i "$i" -t "$t" -pn "$p" --full -old &>/dev/null 
                    run_cmd jgtmlcli -i "$i" -t "$t" -pn "$p" --full -old &>/dev/null 
                done
            fi
        ) &
        
        # Limit parallel jobs
        while [ $(jobs -rp | wc -l) -ge $MAX_PARALLEL ]; do
            sleep 0.1
        done
    done
    wait

    # Parallel uploads for this timeframe
    echo "🔼 Uploading $t files..."
    for p in $patterns; do
        (
            cd "$JGTPY_DATA_FULL" 2>/dev/null || continue
            for d in ttf mlf targets/mx; do
                (cd "$d" 2>/dev/null && droxul upload ./*"$t"*"$p"*.csv "/dist/data/full/$d/") &>/dev/null
            done
            echo "✅ $t $p upload complete"
        ) &
    done
    wait
done

echo "✨ All operations completed successfully"
